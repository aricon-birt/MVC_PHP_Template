# [TA6-5] .gitignore: rutas que Git NO debe controlar.
# La "/" inicial = desde la raíz del repositorio.

# Dependencias de Composer: se regeneran con "composer install".
# Se ignora el CONTENIDO (/*), no la carpeta, para poder hacer la excepción:
# el "!" vuelve a incluir .gitkeep y así la carpeta existe en GitHub.
/vendor/*
!/vendor/.gitkeep

# Logs: se guarda la carpeta, no los registros
/logs/*
!/logs/.gitkeep

# Credenciales reales: NUNCA al repositorio
/config/config.local.php
.env
